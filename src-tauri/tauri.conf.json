{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beatos",
  "version": "0.1.0",
  "identifier": "com.beatos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "beatos",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "C:/Users/kismo/OneDrive/Dokumente/._BEAT LIBRARY/**",
          "C:\\Users\\kismo\\OneDrive\\Dokumente\\._BEAT LIBRARY\\**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; media-src 'self' blob: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
